# verus-connect v4 configuration

# ── Required ──────────────────────────────────────────────────
SIGNING_IADDRESS=youridentity@
CALLBACK_URL=https://yoursite.com/verus/verusidlogin

# ── Daemon mode (multi-chain) ─────────────────────────────────
# Comma-separated chains to support. RPC credentials are read
# automatically from each daemon's standard .conf file:
#   VRSC      ~/.komodo/VRSC/VRSC.conf
#   PBaaS     ~/.verus/pbaas/<hex>/<hex>.conf
CHAINS=vrsc,varrr,vdex,chips

# Chain used for challenge issuance when the client doesn't pick one.
# Must be in CHAINS above.
DEFAULT_CHAIN=vrsc

# Optional per-chain overrides if your conf file is somewhere non-standard:
# CONF_PATH_VRSC=/custom/path/VRSC.conf
# CONF_PATH_VARRR=/custom/path/vARRR.conf

# ── Lite mode (single-chain, serverless) ──────────────────────
# Auto-detected if CHAINS is unset and PRIVATE_KEY is set.
# PRIVATE_KEY=<your WIF private key>
# VERIFY_NODE_URL=https://api.verus.services
# CHAIN=vrsc

# ── Server ────────────────────────────────────────────────────
PORT=8100
HOST=127.0.0.1
CORS_ORIGINS=*
# DEBUG=1
