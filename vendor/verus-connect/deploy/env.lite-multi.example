# verus-connect — lite mode, multi-chain (VRSC + PBaaS)
#
# Drop at /etc/verus-connect/<app>.env  (mode 0600)
# Reference: README.md "Lite Mode (single or multi-chain)"

# VerusID this sidecar signs challenges with. MUST exist as an active
# identity on every chain listed in CHAINS — see the main README's
# "Exporting your signing identity to other chains" for the one-time
# `sendcurrency ... exportid` step per chain.
SIGNING_IADDRESS=yourapp.VRSC@

CALLBACK_URL=https://yourapp.com/verus/verusidlogin

# Optional (5.2+). Mobile redirect-back landing URL — see env.lite-single.example
# for the full explanation. Defaults to the origin of CALLBACK_URL.
# REDIRECT_URL=https://yourapp.com/login/return

# Offline signing key — derives SIGNING_IADDRESS's current primary R-address.
PRIVATE_KEY=YourWifKeyGoesHere

# ── Networks this sidecar accepts logins from ────────────────────────────
# CHAINS is the only switch that controls which networks appear in the
# wallet picker. Order doesn't matter; DEFAULT_CHAIN is what `POST /login`
# uses when the client omits `chain`.
#
# Standard 4-chain shape — VRSC + every public PBaaS chain. The
# `<chain>.rpc.verus.cx` subdomains are drop-in verusd-compatible RPC
# endpoints with no signup required. To run your own RPC instead, swap
# in the URLs (any verusd-compatible HTTPS endpoint works).
#
# To support a subset, just shorten CHAINS and omit the matching
# VERIFY_NODE_URL_* lines. For example, VRSC + vARRR only:
#   CHAINS=vrsc,varrr
#   DEFAULT_CHAIN=vrsc
#   VERIFY_NODE_URL_VRSC=https://rpc.verus.cx/
#   VERIFY_NODE_URL_VARRR=https://varrr.rpc.verus.cx/
# (omit VDEX/CHIPS entirely)
#
# Startup validates that every name in CHAINS has a matching
# VERIFY_NODE_URL_<CHAIN>= set, so a missing URL fails fast instead of
# failing at first login attempt.
CHAINS=vrsc,varrr,vdex,chips
DEFAULT_CHAIN=vrsc

VERIFY_NODE_URL_VRSC=https://rpc.verus.cx/
VERIFY_NODE_URL_VARRR=https://varrr.rpc.verus.cx/
VERIFY_NODE_URL_VDEX=https://vdex.rpc.verus.cx/
VERIFY_NODE_URL_CHIPS=https://chips.rpc.verus.cx/

PORT=8101
HOST=127.0.0.1

CORS_ORIGINS=https://yourapp.com
