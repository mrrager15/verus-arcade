{
  "name": "verus-connect",
  "version": "5.2.1",
  "description": "VerusID authentication, payments, and identity requests — multi-chain daemon or lite mode",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "verus-connect": "dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "default": "./dist/web.global.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.cjs start",
    "install:lite": "npm install verusid-ts-client@github:VerusCoin/verusid-ts-client#9b5a6f0db30ccf2a57c7a952d0191e5da7f3f195"
  },
  "engines": {
    "node": ">=20.0.0 <23"
  },
  "license": "MIT",
  "dependencies": {
    "express": "4.22.1",
    "verus-typescript-primitives": "github:VerusCoin/verus-typescript-primitives#27e6c076def4416c20a568e31e4c406b10612807"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/express": "4.17.25",
    "@types/node": "22.15.0",
    "qrcode": "1.5.3",
    "tsup": "8.4.0",
    "typescript": "5.8.3"
  }
}
