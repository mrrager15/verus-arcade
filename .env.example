# Verus Arcade defaults to VRSCTEST and one chain only.
NODE_ENV=development
ARCADE_NETWORK=vrsctest
ARCADE_ORIGIN=http://127.0.0.1:8100
ARCADE_AUTH_PORT=8100
ARCADE_ID=Arcade@

# --- v2: wallet-requests (fase 0+) ---
# i-adres van Arcade@ op VRSCTEST. Tekent verzoeken aan Verus Mobile.
ARCADE_SERVICE_ID=i4hktkkrvYoUfLZpXWQU5hagpnJuFSaNLp
# Geheime sleutel (WIF) van het primaire adres van Arcade@. ALLEEN in je lokale .env,
# nooit in git, nooit in de gedeelde werkmap. Exporteren: verus -chain=vrsctest dumpprivkey R9tx...
# ARCADE_SERVICE_WIF=
# Publieke RPC voor lezen zonder daemon (verifier). Leeg = de lokale daemon via conf.
# VERUS_RPC_URL=https://api.verustest.net
# Hoe Verus Mobile antwoorden terugstuurt: redirect (lokaal, http) of post (productie, https).
WALLET_RESPONSE_MODE=redirect
# Geldigheid van een wallet-verzoek in blokken (60 = ongeveer een uur).
REQUEST_TTL_BLOCKS=60
# Gift-card onboarding (fase 3).
GIFTS_ENABLED=false

# Optional overrides
# ARCADE_VRSCTEST_CONF=C:\Users\you\AppData\Roaming\Komodo\vrsctest\vrsctest.conf
# ARCADE_DATABASE_PATH=C:\path\to\verus-arcade.sqlite
# ARCADE_SESSION_TTL_SECONDS=43200
# ARCADE_DEBUG=1

# Mainnet is intentionally undocumented here beyond the guard name. It is not an MVP
# deployment target and additionally requires NODE_ENV=production, HTTPS, an explicit
# acknowledgement, reviewed identities/VDXF keys, and completed launch validation.
