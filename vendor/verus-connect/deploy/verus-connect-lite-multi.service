[Unit]
Description=verus-connect sidecar (lite mode, multi-chain)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/verus-connect

# Per-app env: copy env.lite-multi.example to /etc/verus-connect/<app>.env,
# chmod 600, and update the path below to match. The signing identity
# referenced in SIGNING_IADDRESS must exist on every chain in CHAINS — see
# the main README's "Exporting your signing identity to other chains".
EnvironmentFile=/etc/verus-connect/CHANGEME.env

ExecStart=/usr/bin/node dist/cli.cjs start
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/verus-connect
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
