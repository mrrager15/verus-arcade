# verus-connect — lite mode, single chain (VRSC)
#
# Drop at /etc/verus-connect/<app>.env  (mode 0600)
# Reference: README.md "Lite Mode (single or multi-chain)"

# VerusID this sidecar signs challenges with.
# The WIF below MUST derive this identity's *current* primary R-address.
# If you ever rotate the identity, regenerate PRIVATE_KEY from the new key.
SIGNING_IADDRESS=yourapp.VRSC@

# Public URL the wallet POSTs the signed response to. Must end with
# /verus/verusidlogin (or whatever path your nginx routes to the sidecar).
CALLBACK_URL=https://yourapp.com/verus/verusidlogin

# Optional (5.2+). Where the wallet redirects users after a same-device sign
# (the deeplink-click flow on mobile). Defaults to the origin of CALLBACK_URL
# above when unset, which lands users on your site root — fine if your root
# page hosts the verus-connect-login element or otherwise handles the
# ?challengeId=… URL params. Set explicitly if you want a different landing
# page (e.g. /login/return).
# REDIRECT_URL=https://yourapp.com/login/return

# Offline signing key for SIGNING_IADDRESS's primary R-address.
# Get it with:   verus dumpprivkey RxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxX
# Never check this file into git.
PRIVATE_KEY=YourWifKeyGoesHere

# Public Verus RPC for verification. The scan.verus.cx subdomains are
# drop-ins; you can also point at your own node.
VERIFY_NODE_URL=https://rpc.verus.cx/

# Optional: which chain (default vrsc). Ignored when CHAINS is set.
CHAIN=vrsc

# Sidecar listens here. Loopback only — nginx fronts it.
PORT=8101
HOST=127.0.0.1

# CORS origin must match the public site that loads the login UI.
CORS_ORIGINS=https://yourapp.com
