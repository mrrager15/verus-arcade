# Your VerusID. Must exist on every chain in CHAINS.
SIGNING_IADDRESS=yourid@

# Where the mobile wallet POSTs signed responses. Must be reachable from the
# user's phone — use your public domain in production, ngrok/cloudflared/LAN IP
# for local testing.
CALLBACK_URL=https://yourapp.com/verus/verusidlogin

# Chains this sidecar accepts logins from. RPC credentials are read from each
# daemon's .conf file (~/.komodo/VRSC/VRSC.conf, ~/.verus/pbaas/<hex>/<hex>.conf).
CHAINS=vrsc
DEFAULT_CHAIN=vrsc

# Server port.
PORT=3030

# Default: CORS is locked to CALLBACK_URL's origin (only your own site can call
# this server). If you genuinely need cross-origin, set an explicit allow-list:
# CORS_ORIGINS=https://yourapp.com,https://app.yourapp.com
