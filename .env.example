# Verus Arcade defaults to VRSCTEST and one chain only.
NODE_ENV=development
ARCADE_NETWORK=vrsctest
ARCADE_ORIGIN=http://127.0.0.1:8100
ARCADE_AUTH_PORT=8100
ARCADE_ID=Arcade@

# Optional overrides
# ARCADE_VRSCTEST_CONF=C:\Users\you\AppData\Roaming\Komodo\vrsctest\vrsctest.conf
# ARCADE_DATABASE_PATH=C:\path\to\verus-arcade.sqlite
# ARCADE_SESSION_TTL_SECONDS=43200
# ARCADE_DEBUG=1

# Mainnet is intentionally undocumented here beyond the guard name. It is not an MVP
# deployment target and additionally requires NODE_ENV=production, HTTPS, an explicit
# acknowledgement, reviewed identities/VDXF keys, and completed launch validation.
