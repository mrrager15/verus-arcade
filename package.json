{
	"name": "verus-arcade",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test server/*.test.mjs server/db/*.test.mjs server/games/word-grid/*.test.mjs server/verus/*.test.mjs shared/*.test.mjs shared/games/*.test.mjs shared/games/*/*/*.test.mjs scripts/storage-poc/*.test.mjs scripts/agent/*.test.mjs",
		"test:storage-poc": "node --test scripts/storage-poc/*.test.mjs",
		"server": "node --env-file-if-exists=.env server/auth.mjs",
		"server:test": "node --env-file-if-exists=.env server/test-server.mjs",
		"server:watch": "node server/dev-watch.mjs",
		"server:prod": "node --env-file-if-exists=.env server/prod.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/express": "^5.0.6",
		"@types/qrcode": "^1.5.6",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"express": "^5.2.1",
		"qrcode": "^1.5.4",
		"verus-connect": "file:vendor/verus-connect",
		"verus-typescript-primitives": "https://github.com/VerusCoin/verus-typescript-primitives/archive/3ffa9d77a3dd98c23fe4f66cf4368946906de780.tar.gz",
		"verusd-rpc-ts-client": "https://github.com/VerusCoin/verusd-rpc-ts-client/archive/e8ea8c21f8a3d845e20189440dcd820d16f00891.tar.gz",
		"verusid-ts-client": "https://github.com/VerusCoin/verusid-ts-client/archive/933e8f8da1a51b99ba7533701dddb9914b7a06b7.tar.gz"
	},
	"overrides": {
		"verus-typescript-primitives": "https://github.com/VerusCoin/verus-typescript-primitives/archive/3ffa9d77a3dd98c23fe4f66cf4368946906de780.tar.gz",
		"verusd-rpc-ts-client": "https://github.com/VerusCoin/verusd-rpc-ts-client/archive/e8ea8c21f8a3d845e20189440dcd820d16f00891.tar.gz",
		"@bitgo/utxo-lib": "https://github.com/VerusCoin/BitGoJS/archive/2d3240429b7664fb01ca3f0f9e1c2b6da803f68d.tar.gz",
		"bitcoin-ops": "https://github.com/VerusCoin/bitcoin-ops/archive/a5f8f56e658301bc39881d41740b3a0010530efd.tar.gz",
		"blake2b": "https://github.com/VerusCoin/blake2b/archive/578dc12b7b68a3ce76d1e1add1402b28a5890a6b.tar.gz"
	}
}
