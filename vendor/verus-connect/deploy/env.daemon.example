# verus-connect — daemon mode (local verusd holds the signing keys)
#
# Drop at /etc/verus-connect/<app>.env  (mode 0600)
# Reference: README.md "Daemon Mode (multi-chain)"

# VerusID this sidecar signs challenges with. The LOCAL verusd's wallet
# must hold the primary private key for this identity — daemon mode does
# NOT use PRIVATE_KEY, everything goes through verusd's signdata RPC.
# If verusd doesn't have the key:
#     verus importprivkey "YourWif" "" false
# (the `false` skips a full rescan; the key controls a fresh identity with
# no UTXO history, so a rescan adds nothing)
SIGNING_IADDRESS=yourapp.VRSC@

CALLBACK_URL=https://yourapp.com/verus/verusidlogin

# Optional (5.2+). Mobile redirect-back landing URL — see env.lite-single.example
# for the full explanation. Defaults to the origin of CALLBACK_URL.
# REDIRECT_URL=https://yourapp.com/login/return

# Chains this sidecar accepts logins from. Each chain needs a running
# local verusd whose conf file the sidecar can read.
CHAINS=vrsc,varrr,vdex,chips
DEFAULT_CHAIN=vrsc

# Optional: override a chain's conf file path. Default locations:
#   VRSC               ~/.komodo/VRSC/VRSC.conf
#   PBaaS children     ~/.verus/pbaas/<hex>/<hex>.conf
# Uncomment + edit if your daemons run with non-standard datadirs.
# CONF_PATH_VRSC=/root/.komodo/VRSC/VRSC.conf
# CONF_PATH_VARRR=/root/.verus/pbaas/e9e10955b7d16031e3d6f55d9c908a038e3ae47d/vARRR.conf

PORT=8101
HOST=127.0.0.1

CORS_ORIGINS=https://yourapp.com
